# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ขึ้น GitHub)
#   Windows : copy .env.example .env
#   Mac/Linux: cp .env.example .env

# พอร์ตที่ API จะรัน
#   - รันบนเครื่องตัวเอง: ใช้ 3000 ได้เลย
#   - รันบนเซิร์ฟเวอร์อาจารย์: ต้องใช้ "Assigned backend port" ที่ระบบแจ้งตอน SSH login เท่านั้น
PORT=3000

# การเชื่อมต่อ MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ip_std6730202645

# กุญแจสำหรับเซ็น JWT — ต้องเปลี่ยนเป็นค่าสุ่มของตัวเอง ห้ามใช้ค่านี้จริง
# สร้างค่าใหม่:  openssl rand -hex 32
JWT_SECRET=เปลี่ยนเป็นค่าสุ่มยาวๆ_อย่างน้อย32ตัวอักษร
JWT_EXPIRES=7d
